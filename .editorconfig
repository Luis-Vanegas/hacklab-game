# Formato básico compartido por todos los editores y agentes
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Los dos espacios al final son saltos de línea en Markdown
trim_trailing_whitespace = false
