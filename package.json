{
  "name": "hacklab-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juego de terminal hacker en el navegador. Enseña ciberseguridad, scripting y conceptos de ingeniería.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@xterm/xterm": "^5.5.0",
    "@react-three/fiber": "^9.1.2",
    "@react-three/drei": "^10.0.0",
    "three": "^0.175.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.33.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
